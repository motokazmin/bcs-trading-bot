# Проверка вперёд 0023: портфель месяца в журнал (scripts/pairs/momentum_auto.sh) под пользователем trader.
# Ставится deploy/setup-trader.sh в /etc/systemd/system/. Пуш журнала — deploy key trader с правом записи.
[Unit]
Description=Моментум 0023: портфель месяца в журнал
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=trader
Group=trader
Environment=TZ=Europe/Moscow
WorkingDirectory=/home/trader/momentum-paper
ExecStart=/home/trader/momentum-paper/scripts/pairs/momentum_auto.sh
NoNewPrivileges=true

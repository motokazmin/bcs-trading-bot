# Проверка вперёд 0023: портфель месяца в журнал (scripts/pairs/momentum_auto.sh) под пользователем apps.
# Ставится deploy/setup-apps.sh в /etc/systemd/system/. Пуш журнала — deploy key apps с правом записи.
[Unit]
Description=Моментум 0023: портфель месяца в журнал
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=apps
Group=apps
Environment=TZ=Europe/Moscow
WorkingDirectory=/home/apps/momentum-paper
ExecStart=/home/apps/momentum-paper/scripts/pairs/momentum_auto.sh
NoNewPrivileges=true

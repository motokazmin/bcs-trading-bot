# Три попытки в день по Москве: скрипт идемпотентен, лишние запуски ничего не делают.
# Первый успешный в новом месяце коммитит портфель до клиринга первого торгового дня (~18:50).
[Unit]
Description=Моментум 0023: ежедневная проверка, не пора ли считать портфель

[Timer]
OnCalendar=*-*-* 07,12,16:00 Europe/Moscow
Persistent=true

[Install]
WantedBy=timers.target

# Бот под пользователем apps (deploy/setup-apps.sh). Секреты — /etc/trading-bot/env (root:apps 640):
# BCS_REFRESH_TOKEN, ADMIN_TOKEN, HTTP_LISTEN. Конфиг — BOT_CONFIG ниже.
# Управление: systemctl status|restart trading-bot; журнал — /var/log/trading-bot/bot.log.
[Unit]
Description=BCS trading bot
Wants=network-online.target
After=network-online.target
# 5 перезапусков за 10 минут — служба «упала», OnFailure шлёт сообщение. С лимитом по умолчанию
# (5 за 10 с) при RestartSec=15 он не срабатывает никогда: бот перезапускался бы молча бесконечно.
StartLimitIntervalSec=600
StartLimitBurst=5
OnFailure=notify@%n.service

[Service]
User=apps
Group=apps
WorkingDirectory=/home/apps/bcs-trading-bot
EnvironmentFile=/etc/trading-bot/env
Environment=BOT_CONFIG=configs/runs/paper-m15.yaml
ExecStart=/home/apps/bcs-trading-bot/bin/bot -config ${BOT_CONFIG} -http-listen ${HTTP_LISTEN} -log-file /var/log/trading-bot/bot.log
# SIGTERM — штатная остановка (signal.NotifyContext в cmd/bot)
KillSignal=SIGTERM
TimeoutStopSec=60
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target

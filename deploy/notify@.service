# Сообщение в Telegram об упавшей службе: OnFailure=notify@%n.service в юните службы.
[Unit]
Description=Уведомление: служба %i упала

[Service]
Type=oneshot
User=apps
Group=apps
ExecStart=/home/apps/momentum-paper/scripts/notify.sh "служба %i упала и не поднялась после перезапусков: systemctl status %i; journalctl -u %i -n 50"
